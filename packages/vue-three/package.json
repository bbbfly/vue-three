{
  "name": "@vue-three/core",
  "version": "1.0.0",
  "description": "Vue 3 composition API for Three.js",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.4",
    "vue-tsc": "^3.2.7"
  },
  "dependencies": {
    "lil-gui": "^0.21.0"
  }
}
