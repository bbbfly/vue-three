    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.7",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
